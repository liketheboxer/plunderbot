# Copy to .env for local runs. In Exocomp these are the unit's settings and secrets.

# Secret: the bot token from the Discord Developer Portal (Bot > Reset Token). Never commit it.
DISCORD_TOKEN=

# Optional: a server ID to sync slash commands to instantly while testing.
# Leave empty in production; commands then sync globally.
DEV_GUILD_ID=

# Optional: used until /admin timezone is set on a server.
DEFAULT_TIMEZONE=America/Los_Angeles

# Local runs only; Exocomp uses /data.
DATA_DIR=./data
READY_FILE=./data/ready

LOG_LEVEL=INFO
